{
  "name": "claude-dbot",
  "version": "0.1.0",
  "description": "Discord bot that lets server members invoke Claude via their own or shared Claude subscriptions (Agent SDK)",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "register-commands": "tsx src/registerCommands.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "DBOT_DATA_DIR=/tmp/dbot-smoke DISCORD_TOKEN=x DISCORD_CLIENT_ID=x tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.238",
    "discord.js": "^14.16.0",
    "dotenv": "^16.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
