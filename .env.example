# Copy to .env and fill in. Never commit .env.

# From https://discord.com/developers/applications -> your app -> Bot -> Token
DISCORD_TOKEN=

# From the same page: Application ID (General Information)
DISCORD_CLIENT_ID=

# Your Discord user ID (right-click your name -> Copy User ID, with developer mode on).
# The admin can use /projects commands and sees extra diagnostics.
ADMIN_DISCORD_ID=

# Your Discord server ID for instant slash-command registration during development.
# Without it, commands register globally (up to 1h to appear).
# DEV_GUILD_ID=

# Default model when /ask doesn't specify one: haiku | sonnet | opus | fable (default: sonnet)
# DBOT_DEFAULT_MODEL=sonnet

# Where the bot stores its database and encryption key (default: ./data)
# DBOT_DATA_DIR=./data

# Default cooldown (minutes) applied to a token when a rate limit is hit and
# the error does not include a reset time (default: 60)
# DBOT_DEFAULT_COOLDOWN_MIN=60
